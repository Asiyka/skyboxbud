# Скопіюйте цей файл як .env.local і впишіть свої значення (див. README → «Заявки в Telegram»).
# .env.local не потрапляє в git. На Vercel ці ж змінні задаються в Settings → Environment Variables.

TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=-1001234567890

# Довільний рядок (лише латиниця, цифри, _ і -). Той самий — у Vercel. Згенерувати: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=


# 1 — показувати кнопку «📅 Дата й час» (міні-застосунок). Вмикати після налаштування Mini App у @BotFather.
TELEGRAM_MINI_APP=
